generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantRole {
  TENANT_ADMIN // Admin entité
  ACCOUNTANT // Comptable
  TREASURER // Trésorier
  DEPARTMENT_HEAD // Responsable département
  PASTOR // Pasteur
  COUNTING_MEMBER // Membre commission de comptage
}

enum EventType {
  SERVICE // Culte
  VIGIL // Veillée
  CAMP // CAMP SOV...
  CONFERENCE
  OTHER
}

enum FundType {
  UNRESTRICTED // Fonds libre
  RESTRICTED // Fonds affecté
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum IncomeType {
  TITHE // Dîme
  OFFERING // Offrande ordinaire
  SPECIAL_OFFERING // Offrande spéciale (collecte ciblée)
  DONATION // Don
}

enum PaymentChannel {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum CountingPvStatus {
  DRAFT
  SIGNED
  VALIDATED
}

// ---------------------------------------------------------------------------
// Racine multi-tenant
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  city      String?
  country   String? // ISO 3166-1 alpha-2
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles         UserTenantRole[]
  departments       Department[]
  events            Event[]
  funds             Fund[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  attachments       ExpenseAttachment[]
  incomes           Income[]
  countingPvs       CountingPv[]
  pvSignatories     CountingPvSignatory[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Identité & accès — users globaux, rattachés aux tenants via user_tenant_roles
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  isGlobalAdmin Boolean   @default(false) @map("is_global_admin")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenantRoles         UserTenantRole[]
  refreshTokens       RefreshToken[]
  headedDepartments   Department[]          @relation("DepartmentHead")
  requestedExpenses   Expense[]             @relation("ExpenseRequester")
  approvedExpenses    Expense[]             @relation("ExpenseApprover")
  uploadedAttachments ExpenseAttachment[]   @relation("AttachmentUploader")
  pvSignatures        CountingPvSignatory[] @relation("PvSignatory")

  @@map("users")
}

model UserTenantRole {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, role])
  @@index([tenantId])
  @@map("user_tenant_roles")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Référentiels globaux (pas de tenant_id)
// ---------------------------------------------------------------------------

model Currency {
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String  @unique // ISO 4217 : XOF, EUR, USD...
  name     String
  symbol   String?
  decimals Int     @default(2) // XOF = 0
  isActive Boolean @default(true) @map("is_active")

  expenses   Expense[]
  incomes    Income[]
  baseRates  ExchangeRate[] @relation("BaseCurrency")
  quoteRates ExchangeRate[] @relation("QuoteCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id              String   @id @default(uuid(7)) @db.Uuid
  baseCurrencyId  String   @map("base_currency_id") @db.Uuid
  quoteCurrencyId String   @map("quote_currency_id") @db.Uuid
  rate            Decimal  @db.Decimal(18, 8)
  validFrom       DateTime @map("valid_from") @db.Date
  source          String?
  createdAt       DateTime @default(now()) @map("created_at")

  baseCurrency  Currency @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  quoteCurrency Currency @relation("QuoteCurrency", fields: [quoteCurrencyId], references: [id])

  @@unique([baseCurrencyId, quoteCurrencyId, validFrom])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Organisation (tenant-scoped)
// ---------------------------------------------------------------------------

model Department {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  code       String?
  headUserId String?   @map("head_user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  head     User?     @relation("DepartmentHead", fields: [headUserId], references: [id])
  events   Event[]
  expenses Expense[]
  incomes  Income[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model Event {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  name         String
  type         EventType
  location     String?
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  expenses    Expense[]
  incomes     Income[]
  countingPvs CountingPv[]

  @@index([tenantId, startsAt])
  @@map("events")
}

model Fund {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  type        FundType
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]
  incomes  Income[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("funds")
}

// ---------------------------------------------------------------------------
// Dépenses — frais de note + pièces justificatives
// ---------------------------------------------------------------------------

// Catégories gérées par chaque église depuis l'interface (pas une liste figée)
model ExpenseCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  reference       String
  label           String
  description     String?
  amount          Decimal         @db.Decimal(18, 2)
  currencyId      String          @map("currency_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  paymentMethod   PaymentChannel? @map("payment_method")
  status          ExpenseStatus   @default(DRAFT)
  expenseDate     DateTime        @map("expense_date") @db.Date
  requesterId     String          @map("requester_id") @db.Uuid
  departmentId    String?         @map("department_id") @db.Uuid
  eventId         String?         @map("event_id") @db.Uuid
  fundId          String?         @map("fund_id") @db.Uuid
  submittedAt     DateTime?       @map("submitted_at")
  approvedAt      DateTime?       @map("approved_at")
  approvedById    String?         @map("approved_by_id") @db.Uuid
  rejectionReason String?         @map("rejection_reason")
  paidAt          DateTime?       @map("paid_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  currency    Currency            @relation(fields: [currencyId], references: [id])
  category    ExpenseCategory     @relation(fields: [categoryId], references: [id])
  requester   User                @relation("ExpenseRequester", fields: [requesterId], references: [id])
  approvedBy  User?               @relation("ExpenseApprover", fields: [approvedById], references: [id])
  department  Department?         @relation(fields: [departmentId], references: [id])
  event       Event?              @relation(fields: [eventId], references: [id])
  fund        Fund?               @relation(fields: [fundId], references: [id])
  attachments ExpenseAttachment[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, expenseDate])
  @@index([tenantId, departmentId])
  @@index([tenantId, categoryId])
  @@map("expenses")
}

model ExpenseAttachment {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  expenseId    String    @map("expense_id") @db.Uuid
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  storageKey   String    @unique @map("storage_key")
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  expense    Expense @relation(fields: [expenseId], references: [id])
  uploadedBy User    @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([expenseId])
  @@map("expense_attachments")
}

// ---------------------------------------------------------------------------
// Recettes — offrandes, dons, PV de comptage
// ---------------------------------------------------------------------------

model Income {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  type         IncomeType
  amount       Decimal        @db.Decimal(18, 2)
  currencyId   String         @map("currency_id") @db.Uuid
  channel      PaymentChannel
  receivedAt   DateTime       @map("received_at") @db.Date
  donorName    String?        @map("donor_name")
  eventId      String?        @map("event_id") @db.Uuid
  fundId       String?        @map("fund_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  countingPvId String?        @map("counting_pv_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  createdBy    String?        @map("created_by") @db.Uuid
  updatedBy    String?        @map("updated_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  currency   Currency    @relation(fields: [currencyId], references: [id])
  event      Event?      @relation(fields: [eventId], references: [id])
  fund       Fund?       @relation(fields: [fundId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  countingPv CountingPv? @relation(fields: [countingPvId], references: [id])

  @@index([tenantId, receivedAt])
  @@index([tenantId, type])
  @@map("incomes")
}

model CountingPv {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  reference String
  status    CountingPvStatus @default(DRAFT)
  eventId   String?          @map("event_id") @db.Uuid
  countedAt DateTime         @map("counted_at")
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  createdBy String?          @map("created_by") @db.Uuid
  updatedBy String?          @map("updated_by") @db.Uuid

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  event       Event?                @relation(fields: [eventId], references: [id])
  incomes     Income[]
  signatories CountingPvSignatory[]

  @@unique([tenantId, reference])
  @@index([tenantId, countedAt])
  @@map("counting_pvs")
}

model CountingPvSignatory {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  countingPvId String    @map("counting_pv_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  signedAt     DateTime? @map("signed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  countingPv CountingPv @relation(fields: [countingPvId], references: [id])
  user       User       @relation("PvSignatory", fields: [userId], references: [id])

  @@unique([countingPvId, userId])
  @@index([tenantId])
  @@map("counting_pv_signatories")
}

// ---------------------------------------------------------------------------
// Audit — append-only, volontairement sans FK pour survivre aux suppressions
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid // null = action système/globale
  userId     String?  @map("user_id") @db.Uuid
  action     String // create, update, delete, login, status_change...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
