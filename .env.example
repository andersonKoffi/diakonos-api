# Application
NODE_ENV=development
PORT=3000

# Base de données
# Port 5433 côté hôte pour ne pas entrer en conflit avec un PostgreSQL local sur 5432
POSTGRES_PORT=5433
# DATABASE_URL     : utilisateur PROPRIÉTAIRE (superuser) — migrations et seed uniquement
# APP_DATABASE_URL : utilisateur APPLICATIF — celui de l'API NestJS, soumis au RLS
DATABASE_URL=postgresql://diakonos:diakonos@localhost:5433/diakonos?schema=public
APP_DATABASE_URL=postgresql://diakonos_app:diakonos_app@localhost:5433/diakonos?schema=public

# JWT (durées en secondes)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=2592000

# Origines autorisées pour le frontend Angular (séparées par des virgules)
CORS_ORIGINS=http://localhost:4200

# Stockage des pièces justificatives (disque local)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
